{
  "_note": "音声認識の聞き間違い → 正しい言い方。質問文に最初に当てる（lib/misheard.ts）。[正規表現, 置き換え] の順に適用。実際のログ（roas.ask_log）を見て追加する",
  "rules": [
    ["受診|受信|自身|地神", "じしん"],
    ["イカ様", "イカサマ"],
    ["序列", "じゃれつく"],
    ["([HABCDS]{1,3}) ?[ブプ]リ", "$1振り"],
    ["トッカ|特価", "特化"],
    ["ガム(?=の|に|が|は|って|で)", "ガブ"],
    ["[どドとト度]?[ひヒ][どド][いイ][でデれレ](?![すし])", "ドヒドイデ"],
    ["海流", "カイリュー"],
    ["[グク]?ソ武者|グソクムシ(?!ャ)", "グソクムシャ"],
    ["目が(?=[ァ-ヴ])", "メガ"],
    ["メガヴォクシー", "メガマフォクシー"],
    ["発寒", "ハッサム"],
    ["絶え", "耐え"],
    ["タイル", "耐える"]
  ]
}
